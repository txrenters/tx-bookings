# Wayfinder output. Generated by the Vite plugin during `npm run build`, so a
# copy from a developer's machine would only risk shipping stale route helpers.
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Server-rendered bundle. vite.config.ts declares no SSR input, so this is only
# ever a local build artefact.
bootstrap/ssr

# The whole of storage/ is excluded rather than just its public tree: the
# Dockerfile recreates the directory skeleton, and anything the application
# writes lives in the storage-app volume on the server.
storage/app
storage/framework/cache/data
storage/framework/sessions
storage/framework/views
storage/logs
storage/pail

