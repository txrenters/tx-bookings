# Runtime environment for the containerised tx-bookings.
#
# Copy to .env.docker on the server and fill in the secrets. Never commit the
# filled copy. Compose reads this with `env_file:`, so every value here is a
# literal -- there is no ${...} interpolation and no shell quoting.
#
# The compose file's OWN variables (APP_SLUG, APP_HOST, HTTP_PORT,
# DB_SOCKET_DIR, APP_VERSION) live in .env beside this file, not here.

APP_NAME="TX Bookings"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false

# Must match the APP_URL baked into the JS bundle at build time -- compose
# derives that from APP_HOST in .env. A mismatch means Wayfinder's URLs point
# somewhere the browser cannot reach and forms silently never submit.
APP_URL=https://bookings.texasrenters.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily, not stack: one file per day under the storage-logs volume, pruned to
# LOG_DAILY_DAYS (14). A single ever-growing laravel.log is unreadable in the
# log viewer and never gets cleaned up.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Empty DB_HOST with DB_SOCKET set is what makes PDO use the socket rather than
# TCP. The socket directory is bind-mounted into the container by
# docker-compose.yml; MySQL sees the connection as 'user'@'localhost'.
DB_HOST=
DB_PORT=3306
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=tx_bookings
DB_USERNAME=tx_bookings
DB_PASSWORD=

# No Redis in this stack. Sessions, cache and the queue all run on MySQL, which
# is why the queue service exists as a separate container.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=bookings@texasrenters.com
MAIL_FROM_NAME="TX Bookings"

# Microsoft calendar integration. The redirect URI registered in Azure must
# match APP_URL above.
MICROSOFT_TENANT=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Personal access token used by the Calendly importer.
CALENDLY_API_KEY=
