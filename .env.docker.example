# Runtime environment for the containerised tx-bookings.
#
# Copy to .env.docker on the server and fill in the secrets. Never commit the
# filled copy. Compose reads this with `env_file:`, so every value here is a
# literal -- there is no ${...} interpolation and no shell quoting.
#
# The compose file's OWN variables (APP_SLUG, APP_HOST, HTTP_PORT,
# DB_SOCKET_DIR, APP_VERSION) live in .env beside this file, not here.

APP_NAME="TR Bookings"
APP_ENV=production
# php artisan key:generate --show
APP_KEY=
APP_DEBUG=false

# Must match the APP_URL baked into the JS bundle at build time -- compose
# derives that from APP_HOST in .env. A mismatch means Wayfinder's URLs point
# somewhere the browser cannot reach and forms silently never submit.
APP_URL=https://bookings.texasrenters.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# daily, not stack: one file per day under the storage-logs volume, pruned to
# LOG_DAILY_DAYS (14). A single ever-growing laravel.log is unreadable in the
# log viewer and never gets cleaned up.
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# Empty DB_HOST with DB_SOCKET set is what makes PDO use the socket rather than
# TCP. The socket directory is bind-mounted into the container by
# docker-compose.yml; MySQL sees the connection as 'user'@'localhost'.
DB_HOST=
DB_PORT=3306
DB_SOCKET=/var/run/mysqld/mysqld.sock
DB_DATABASE=tx_bookings
DB_USERNAME=tx_bookings
DB_PASSWORD=

# No Redis in this stack. Sessions, cache and the queue all run on MySQL, which
# is why the queue service exists as a separate container.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=microsoft-graph
# The bookings address is a shared mailbox: it has no password and cannot use
# SMTP, so mail goes out through Microsoft Graph on the Azure app registration
# below. That registration needs the Mail.Send APPLICATION permission with
# admin consent; scope it to this one mailbox with an Exchange application
# access policy so the app cannot send as everyone in the tenant.
MAIL_FROM_ADDRESS=bookings@texasrenters.com
MAIL_FROM_NAME="TR Bookings"
# Its own app registration, separate from the calendar's MICROSOFT_* one below:
# this holds an application permission that sends as the mailbox with no user
# present. Leave blank to run both from the calendar's registration. The tenant
# must be the real tenant id -- client credentials cannot use "common".
MAIL_GRAPH_TENANT=
MAIL_GRAPH_CLIENT_ID=
MAIL_GRAPH_CLIENT_SECRET=
# Defaults to MAIL_FROM_ADDRESS; set only to send from a different mailbox.
MAIL_GRAPH_MAILBOX=
# Keep a copy in the shared mailbox's Sent Items.
MAIL_GRAPH_SAVE_TO_SENT_ITEMS=false

# Microsoft calendar integration. The redirect URI registered in Azure must
# match APP_URL above.
MICROSOFT_TENANT=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Personal access token used by the Calendly importer.
CALENDLY_API_KEY=

# Twilio, for the text messages workflows send. Account-wide credentials; each
# organization picks which of the account's numbers its texts come from, in the
# organization settings. Leave blank and text messages are never sent.
TWILIO_SID=
TWILIO_AUTH_TOKEN=
