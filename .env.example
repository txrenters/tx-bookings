APP_NAME="TX Bookings"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tx_bookings
DB_USERNAME=root
DB_PASSWORD=
# Set instead of DB_HOST to connect over a Unix socket, as the containers do.
# See the DB_SOCKET_DIR comment in docker-compose.yml.
# DB_SOCKET=/var/run/mysqld/mysqld.sock

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.office365.com
MAIL_PORT=587
# Licensed M365 mailbox + app password. MAIL_FROM_ADDRESS must equal
# MAIL_USERNAME or Exchange rejects the send as spoofing.
MAIL_USERNAME=no-reply@texasrenters.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@texasrenters.com
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Calendar (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI (production):
#   https://bookings.texasrenters.com/integrations/google/callback
# Authorised redirect URI (local):
#   http://localhost:8000/integrations/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 (https://entra.microsoft.com -> App registrations)
# Add both under Authentication -> Web platform:
#   https://bookings.texasrenters.com/integrations/microsoft/callback
#   http://localhost:8000/integrations/microsoft/callback
# Use "common" for any tenant, or your tenant id to restrict it.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Default timezone for new users, teams, and schedules. Timestamps are always
# stored in UTC; this only affects what people see and what new schedules use.
SCHEDULING_TIMEZONE=America/Chicago

# New users start marked unavailable on this country's public holidays.
# Leave empty so nobody is opted in by default.
SCHEDULING_HOLIDAY_COUNTRY=US

CALENDLY_API_KEY=
